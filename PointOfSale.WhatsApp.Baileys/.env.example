# Server Configuration
PORT=3000
NODE_ENV=development

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Session Configuration
SESSION_IDLE_TIMEOUT_MINUTES=10
SESSION_CLEANUP_INTERVAL_MINUTES=2

# Pool Configuration
POOL_SIZE=10
POOL_MAX_CONNECTIONS_PER_MEMBER=50
# Pool members format: "member1:+1234567890,member2:+9876543210"
# Each member should have a unique ID and phone number
POOL_MEMBERS=

# Security Configuration
# IMPORTANT: Change this to a secure random string in production (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_STATE_ENCRYPTION_SECRET=change-this-in-production-to-a-secure-random-string-minimum-32-chars

# Logging
LOG_LEVEL=info
