    <Compile Include="Accounting\CommerceAccountingServiceTests.cs" />
    <Compile Include="Accounting\FinancialReportServiceTests.cs" />
    <Compile Include="Accounting\T08EcommerceCogsPostingTests.cs" />
    <Compile Include="Accounting\T08EcommerceCogsOutboxProcessorTests.cs" />
  </ItemGroup>


</Project>
