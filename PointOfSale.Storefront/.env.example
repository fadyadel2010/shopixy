# Development environment
# Copy to .env.local for local development

# API base URL (leave empty to use Vite proxy)
VITE_API_URL=

# Default Tenant ID for development (DEV only)
# Used as fallback when subdomain cannot be resolved
# In production, tenant is always resolved from subdomain
VITE_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# Legacy alias (deprecated, use VITE_DEFAULT_TENANT_ID)
VITE_TENANT_ID=00000000-0000-0000-0000-000000000001

# Google OAuth Client ID (from Google Cloud Console)
# Required for "Sign in with Google" button to work
# Get one at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Facebook App ID (from Facebook Developer Console)
# Required for "Sign in with Facebook" button to work  
# Get one at: https://developers.facebook.com/apps/
VITE_FACEBOOK_APP_ID=
