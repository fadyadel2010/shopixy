# =============================================================================
# PointOfSale (Shopixy) — Professional .gitignore
# SOURCE-CODE-BACKED. Every rule below is justified by actual repository
# contents. See docs/project/GIT-1_PROFESSIONAL_GITIGNORE_CERTIFICATION.md
# for the rule-by-rule audit and evidence.
#
# Stack (verified from *.csproj / package.json):
#   - .NET 9 : PointOfSale.API, .Core, .Infrastructure, .Tests, PointOfSale (MVC)
#   - Vite + React 18 + TypeScript : PointOfSale.Web, .CommerceHub, .Storefront
#   - Node + TypeScript : PointOfSale.WhatsApp.Baileys
#   - SQL migration scripts, PowerShell scripts, n8n workflow JSON, Caddy deploy
# =============================================================================

# -----------------------------------------------------------------------------
# Operating System
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Visual Studio / Rider / IDE metadata
# -----------------------------------------------------------------------------
.vs/
.idea/
*.user            # *.csproj.user, launchSettings overrides — machine specific
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user
# Keep shared VS Code workspace config; ignore per-user state only.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# -----------------------------------------------------------------------------
# .NET build output  (bin/, obj/ exist under every .csproj — verified)
# -----------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
*.dll
*.exe
*.pdb
# Playwright browsers unpacked into bin/.../.playwright (verified on disk)
**/.playwright/

# -----------------------------------------------------------------------------
# NuGet
# -----------------------------------------------------------------------------
*.nupkg
*.snupkg
packages/
.nuget/

# -----------------------------------------------------------------------------
# Node / Vite / React  (node_modules + dist verified in all JS projects)
# -----------------------------------------------------------------------------
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Testing & Coverage
# -----------------------------------------------------------------------------
[Tt]est[Rr]esults/
*.trx
*.coverage
*.cobertura.xml
coverage/
.nyc_output/

# -----------------------------------------------------------------------------
# Logs & Temporary files
# -----------------------------------------------------------------------------
*.log
logs/
tmp/
*.tmp

# -----------------------------------------------------------------------------
# Environment files (SECRETS)
# Ignore real env files; ALWAYS keep the committed *.example templates.
# Evidence: .env / .env.production / .env.staging carry runtime config;
# *.example files are intentionally tracked documentation.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# -----------------------------------------------------------------------------
# Application secrets / local overrides (SECRETS)
# appsettings.*.local.json hold developer/test-only credentials (verified:
# appsettings.Development.local.json, appsettings.Test.local.json on disk).
# Committed appsettings.{json,Development,Staging,Production,Test} are
# placeholder-only and MUST stay tracked.
# -----------------------------------------------------------------------------
appsettings.*.local.json
secrets.json
credentials.yaml
credentials.json
*.pfx
*.p12
# Root machine-specific config artifact (appsettings.af22.json) — not a shared config
appsettings.*.local.*

# -----------------------------------------------------------------------------
# Runtime data / generated credentials
# -----------------------------------------------------------------------------
# ASP.NET Data Protection keys (real crypto keys generated at runtime —
# verified: temp/test-environment/data-protection-keys/key-*.xml)
temp/
data-protection-keys/
# Runtime databases / journals
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.pid

# -----------------------------------------------------------------------------
# WhatsApp / Baileys runtime auth state (SECRETS — live session credentials)
# -----------------------------------------------------------------------------
auth_states/
PointOfSale.WhatsApp.Baileys/auth_states/

# -----------------------------------------------------------------------------
# AI tooling / scratch (not part of the product)
# Evidence: .codex-tmp/ (stale probe project), .agents/ scratch dir on disk
# -----------------------------------------------------------------------------
.codex-tmp/
.agents/
.cursor/
.aider*
