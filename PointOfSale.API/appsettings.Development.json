{
  "_SecretsSourceNote": "Use dotnet user-secrets, environment variables, or appsettings.Development.local.json for development-only secrets.",
  "Storefront": {
    "Payments": {
      "Paymob": {
        "Enabled": true,
        "Environment": "Sandbox",
        "SandboxMode": true,
        "FeatureFlags": {
          "Enabled": true,
          "SandboxEnabled": true,
          "ProductionEnabled": false,
          "FoundationHealthEnabled": true,
          "CredentialValidationEnabled": true,
          "EnvironmentValidationEnabled": true,
          "PaymentExecutionEnabled": true,
          "CallbackExecutionEnabled": true,
          "WebhookExecutionEnabled": true,
          "RefundExecutionEnabled": false
        },
        "Callback": {
          "Configured": true,
          "CallbackUrl": "http://localhost:5010/api/webhooks/paymob/callback",
          "WebhookUrl": "http://localhost:5010/api/webhooks/paymob"
        },
        "Capabilities": {
          "SupportsOfficialHttpsApi": true,
          "SupportsHmacVerification": true,
          "SupportsTenantScopedCredentials": true,
          "SupportsSandboxEnvironment": true,
          "SupportsProductionEnvironment": true,
          "PaymentExecutionCertified": true,
          "CallbackCertified": true,
          "ProviderAdapterCertified": true
        }
      }
    }
  },
  "CommerceHub": {
    "Payments": {
      "Stripe": {
        "Enabled": false,
        "Environment": "Sandbox",
        "SandboxMode": true,
        "FeatureFlags": {
          "Enabled": true,
          "SandboxEnabled": true,
          "ProductionEnabled": false,
          "PaymentIntentsEnabled": true,
          "WebhooksEnabled": true,
          "CheckoutSessionsEnabled": false,
          "CaptureEnabled": false,
          "RefundsEnabled": false,
          "CustomerPortalEnabled": false
        }
      },
      "ManualPayment": {
        "Enabled": true,
        "Environment": "Sandbox",
        "SandboxMode": true,
        "FeatureFlags": {
          "Enabled": true,
          "SandboxEnabled": true,
          "ProductionEnabled": false,
          "FoundationHealthEnabled": true,
          "ConfigurationValidationEnabled": true,
          "ProofUploadEnabled": true,
          "ReviewExecutionEnabled": true,
          "ApprovalExecutionEnabled": true,
          "RejectionExecutionEnabled": true,
          "ExpirationExecutionEnabled": false,
          "RefundExecutionEnabled": false
        },
        "Capabilities": {
          "SupportsTenantScopedConfiguration": true,
          "SupportsSandboxEnvironment": true,
          "SupportsProductionEnvironment": true,
          "SupportsInstructionConfiguration": true,
          "SupportsReceiptProofUpload": true,
          "SupportsBankTransfer": true,
          "SupportsVodafoneCash": true,
          "SupportsInstapay": true,
          "SupportsWalletTransfer": true,
          "SupportsCashDeposit": true,
          "SupportsCustomInstructions": true,
          "SupportsOfflineInvoice": true,
          "SupportsReferenceNumber": true,
          "SupportsExpirationPolicy": true,
          "SupportsAcceptedProofTypes": true,
          "ProviderAdapterCertified": true,
          "RuntimeBridgeCertified": true,
          "EvidenceAdapterCertified": true,
          "ReviewWorkflowCertified": true,
          "ApprovalWorkflowCertified": true,
          "PersistenceCertified": true
        },
        "Instructions": {
          "Configured": true,
          "DefaultInstructions": "Transfer to the merchant wallet configured for this store and upload payment proof with the order reference.",
          "RequireReferenceNumber": true,
          "RequireCustomerProof": true
        },
        "Proof": {
          "AcceptedContentTypes": [
            "image/jpeg",
            "image/png",
            "application/pdf"
          ],
          "MaximumUploadBytes": 5242880
        },
        "Expiration": {
          "Configured": true,
          "PendingPaymentTtl": "2.00:00:00",
          "ProofAccessTtl": "7.00:00:00"
        },
        "Channels": [
          {
            "Channel": "VodafoneCash",
            "Enabled": true,
            "DisplayName": "Vodafone Cash",
            "Instructions": "Transfer to the configured merchant wallet number, keep the order reference, and upload payment proof."
          }
        ]
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
