# PointOfSale.API deployment environment variables
# Inject these values from Kubernetes secrets, Azure Key Vault, AWS Secrets Manager,
# GitHub Actions secrets, or your platform's equivalent secret store.

ConnectionStrings__DefaultConnection=

JwtSettings__Secret=
SuperAdminJwt__Secret=
StorefrontJwt__Secret=
CustomerJwt__Secret=
AffiliateJwt__Secret=
CommerceHub__OrderAccessSigningKey=
AbandonedCart__TokenSecret=
AbandonedCart__N8nWebhookUrl=

BaileysService__BaseUrl=
BaileysService__ApiKey=

RabbitMQ__Host=
RabbitMQ__VirtualHost=/
RabbitMQ__Username=
RabbitMQ__Password=

MongoDB__ConnectionString=
MongoDB__DatabaseName=ecommerce_read_db_staging
MongoDB__ProductsCollectionName=products

Redis__ConnectionString=
Redis__InstanceName=pos-staging

Elasticsearch__Url=

Smtp__Enabled=true
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__EnableSsl=true
Smtp__FromEmail=
Smtp__FromName=

CommerceAI__Enabled=false
CommerceAI__Provider=
CommerceAI__Model=
CommerceAI__Endpoint=
CommerceAI__ApiKey=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_SERVICE_URL=
R2_PUBLIC_URL=

# AccountingOutbox deletion strategy
# When true, uses EF Core ExecuteDeleteAsync for bulk deletion (more efficient but bypasses interceptors).
# When false, loads entities and uses RemoveRange (preserves interceptors and cascades).
# Default: false
AccountingOutbox__UseExecuteDelete=false
