# PointOfSale.API deployment environment variables
# Inject these values from Kubernetes secrets, Azure Key Vault, AWS Secrets Manager,
# GitHub Actions secrets, or your platform's equivalent secret store.

ConnectionStrings__DefaultConnection=

JwtSettings__Secret=
SuperAdminJwt__Secret=
StorefrontJwt__Secret=
CustomerJwt__Secret=
AffiliateJwt__Secret=
CommerceHub__OrderAccessSigningKey=
AbandonedCart__TokenSecret=
AbandonedCart__N8nWebhookUrl=

BaileysService__BaseUrl=
BaileysService__ApiKey=

RabbitMQ__Host=
RabbitMQ__VirtualHost=/
RabbitMQ__Username=
RabbitMQ__Password=

MongoDB__ConnectionString=
MongoDB__DatabaseName=ecommerce_read_db_staging
MongoDB__ProductsCollectionName=products

Redis__ConnectionString=
Redis__InstanceName=pos-staging

Elasticsearch__Url=

CertificateProvider__Enabled=false
CertificateProvider__AccountReference=
CertificateProvider__ContactEmail=
CertificateProvider__DirectoryUrl=https://acme-staging-v02.api.letsencrypt.org/directory
CertificateProvider__RevocationControl__Enabled=false
CertificateProvider__RevocationControl__BaseUrl=
CertificateProvider__RevocationControl__RevokePath=/v1/certificates/revoke
CertificateProvider__RevocationControl__HealthPath=/v1/health
CertificateProvider__RevocationControl__BearerToken=
CertificateProvider__RevocationControl__ControlSurfaceReference=
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

CaddyEdge__Enabled=false
CaddyEdge__EdgeCluster=staging-caddy
CaddyEdge__ManagedRoutesDirectory=C:\srv\pointofsale\staging\caddy\custom-domains
CaddyEdge__StorefrontRoot=C:\srv\pointofsale\staging\storefront
CaddyEdge__ApiUpstream=127.0.0.1:5010
CaddyEdge__SecurityHeadersSnippet=shopixy_security_headers
CaddyEdge__AllowLocalTrustedUpstream=true
CaddyEdge__LogRoot=C:\srv\pointofsale\staging\logs
CaddyEdge__ValidateCommand=caddy validate --config C:\srv\pointofsale\staging\Caddyfile
CaddyEdge__ReloadCommand=caddy reload --config C:\srv\pointofsale\staging\Caddyfile
CaddyEdge__ProbeTimeoutSeconds=10

Smtp__Enabled=true
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__EnableSsl=true
Smtp__FromEmail=
Smtp__FromName=

CommerceAI__Enabled=false
CommerceAI__Provider=
CommerceAI__Model=
CommerceAI__Endpoint=
CommerceAI__ApiKey=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_SERVICE_URL=
R2_PUBLIC_URL=

# AccountingOutbox deletion strategy
# When true, uses EF Core ExecuteDeleteAsync for bulk deletion (more efficient but bypasses interceptors).
# When false, loads entities and uses RemoveRange (preserves interceptors and cascades).
# Default: false
AccountingOutbox__UseExecuteDelete=false
